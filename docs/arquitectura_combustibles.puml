@startuml Arquitectura_Plataforma_Combustibles

skinparam backgroundColor #FAFAFA
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 60

skinparam rectangle {
  BackgroundColor #FAFAFA
  BorderColor #CCCCCC
}
skinparam component {
  BackgroundColor #EBF5FB
  BorderColor #1A5276
  FontColor #1A5276
}
skinparam database {
  BackgroundColor #FDEBD0
  BorderColor #D35400
  FontColor #D35400
}
skinparam actor {
  BackgroundColor #F5B7B1
  BorderColor #C0392B
  FontColor #C0392B
}
skinparam cloud {
  BackgroundColor #E8DAEF
  BorderColor #6C3483
  FontColor #6C3483
}
skinparam arrow {
  Color #5D6D7E
  FontColor #5D6D7E
  FontSize 10
}

' ════════════════════════════════════════════════════════
'  ACTORES
' ════════════════════════════════════════════════════════
rectangle "**ACTORES**" as ACTORES #FEF9E7 {
  actor "Administrador\nde Plataforma" as ADMIN
  actor "Estacion\nde Servicio"        as ESTACION
  actor "Distribuidor\nMayorista"      as DISTRIB
  actor "Autoridad\nReguladora"        as REGULADOR
  actor "Usuario\nParticular"          as PARTICULAR
  actor "Ciudadano /\nConsulta Publica" as CIUDADANO
}

rectangle "**INTEGRACIONES EXTERNAS**" as EXTERNAS #E8DAEF {
  cloud "Sensores IoT\n(Nivel tanques)" as IOT
  cloud "API GPS /\nTracking"           as GPS
  cloud "Facturacion\nElectronica"      as FACT
  cloud "Ministerio\nde Minas"          as MINAS
  cloud "Google OAuth API"              as GOAUTH
  cloud "Google Maps API"               as GMAPS
}

' ════════════════════════════════════════════════════════
'  FRONTEND
' ════════════════════════════════════════════════════════
rectangle "**CAPA DE PRESENTACION  —  React.js + Vite + TypeScript  (Vercel)**" as FRONTEND #D6EAF8 {
  component "**M1** Auth\n(Login / JWT)"       as M1  #AED6F1
  component "**M2** Gestion\nde Usuarios"      as M2  #AED6F1
  component "**M3** Gestión de\nEstación"     as M3  #AED6F1
  component "**M4** Precios\ny Zonas"          as M4  #AED6F1
  component "**M5** Normativa\n(Motor Reglas)" as M5  #AED6F1
  component "**M6** Reportes\n(PDF / Excel)"   as M6  #AED6F1
  component "**M7** Auditoria\n(Log)"          as M7  #AED6F1
  component "**M8** Dashboard\n(KPIs)"         as M8  #AED6F1
}

' ════════════════════════════════════════════════════════
'  BACKEND
' ════════════════════════════════════════════════════════
rectangle "**CAPA DE SERVICIOS  —  Node.js + Express + TypeScript  (Railway)**" as BACKEND #D5F5E3 {

  component "Auth Middleware\n(JWT / bcrypt)" as SVC_AUTH #A9DFBF
  component "Passport.js\nOAuth 2.0" as PASSPORT #A9DFBF

  component "/auth\n/auth/google" as API_AUTH #A9DFBF
  component "/usuarios"          as API_USR  #A9DFBF
  component "/estaciones\n/tanques" as API_EST  #A9DFBF
  component "/transacciones"     as API_TRX  #A9DFBF
  component "/precios\n/zonas"   as API_PRC  #A9DFBF
  component "/decretos"          as API_DEC  #A9DFBF
  component "/reportes"          as API_RPT  #A9DFBF
  component "/auditoria"         as API_AUD  #A9DFBF
  component "/dashboard"         as API_DASH #A9DFBF
  component "/publico\n(sin JWT)"as API_PUB  #C8F7C5

  component "Prisma ORM\n(modelos / migraciones)" as ORM #A9DFBF
}

' ════════════════════════════════════════════════════════
'  DATOS
' ════════════════════════════════════════════════════════
rectangle "**CAPA DE DATOS  (Supabase)**" as DATOS #FDEBD0 {
  database "**PostgreSQL 16**\nusuarios / roles\nestaciones_servicio / distribuidores\ntanques / transacciones_combustible\nentregas_distribuidor\nzonas_distribucion / precios_vigentes\ndecretos_normativos / auditoria_log / reportes" as PG    #F5CBA7
  database "**Archivos**\nPDF / Excel" as FILES #F5CBA7
}

' ════════════════════════════════════════════════════════
'  ORDEN VERTICAL
' ════════════════════════════════════════════════════════
ACTORES  -[hidden]down-> FRONTEND
FRONTEND -[hidden]down-> BACKEND
BACKEND  -[hidden]down-> DATOS
EXTERNAS -[hidden]down-> BACKEND

' ════════════════════════════════════════════════════════
'  ACTORES → FRONTEND
' ════════════════════════════════════════════════════════
ADMIN      -down-> M1 : HTTPS
ADMIN      -down-> M2
ADMIN      -down-> M4
ADMIN      -down-> M5

ESTACION   -down-> M1 : HTTPS
ESTACION   -down-> M3
ESTACION   -down-> M6
ESTACION   -down-> M8

DISTRIB    -down-> M1 : HTTPS
DISTRIB    -down-> M3
DISTRIB    -down-> M6

REGULADOR  -down-> M1 : HTTPS
REGULADOR  -down-> M6
REGULADOR  -down-> M7
REGULADOR  -down-> M8

PARTICULAR -down-> M1 : HTTPS
PARTICULAR -down-> M4
PARTICULAR -down-> M5
PARTICULAR -down-> M8

CIUDADANO -down-> M1 : HTTPS
CIUDADANO -down-> M4
CIUDADANO -down-> M5
CIUDADANO -down-> M8

' ════════════════════════════════════════════════════════
'  AUTH MIDDLEWARE protege endpoints privados
' ════════════════════════════════════════════════════════
SVC_AUTH -right-> API_AUTH : protege
SVC_AUTH -right-> API_USR  : protege
SVC_AUTH -right-> API_EST  : protege
SVC_AUTH -right-> API_TRX  : protege
SVC_AUTH -right-> API_PRC  : protege
SVC_AUTH -right-> API_DEC  : protege
SVC_AUTH -right-> API_RPT  : protege
SVC_AUTH -right-> API_AUD  : protege
SVC_AUTH -right-> API_DASH : protege
' API_PUB no pasa por SVC_AUTH (es publica con rate limiting)

' ════════════════════════════════════════════════════════
'  FRONTEND → BACKEND
' ════════════════════════════════════════════════════════
M1  -down-> API_AUTH : REST
M2  -down-> API_USR  : REST
M3  -down-> API_EST  : REST
M3  -down-> API_TRX  : REST
M4  -down-> API_PRC  : REST
M4  -down-> API_PUB  : REST publico
M5  -down-> API_DEC  : REST
M5  -down-> API_PUB  : REST publico
M6  -down-> API_RPT  : REST
M7  -down-> API_AUD  : REST
M8  -down-> API_DASH : REST
M8  -down-> API_PUB  : REST publico

' ════════════════════════════════════════════════════════
'  BACKEND → ORM → BD
' ════════════════════════════════════════════════════════
API_AUTH  -down-> ORM
PASSPORT  -down-> ORM
API_USR  -down-> ORM
API_EST  -down-> ORM
API_TRX  -down-> ORM
API_PRC  -down-> ORM
API_DEC  -down-> ORM
API_RPT  -down-> ORM
API_AUD  -down-> ORM
API_DASH -down-> ORM
API_PUB  -down-> ORM
PASSPORT -down-> ORM : "crea/recupera usuario"

ORM     -down-> PG    : "SQL / Prisma"
API_RPT -down-> FILES : "genera archivos"

' ════════════════════════════════════════════════════════
'  INTEGRACIONES EXTERNAS
' ════════════════════════════════════════════════════════
IOT      -down-> API_EST    : "MQTT/HTTP nivel tanques"
GOAUTH   -down-> PASSPORT   : "OAuth 2.0 callback"
PASSPORT -down-> API_AUTH   : "valida y crea JWT"
GMAPS    -down-> M4         : "JS SDK mapas"
GMAPS    -down-> M8         : "JS SDK mapas"
GPS  -down-> API_TRX  : "HTTP ubicacion"
FACT -down-> API_TRX  : "HTTP factura"
API_RPT -right-> MINAS : "HTTP reporte oficial"

' ════════════════════════════════════════════════════════
'  LEYENDA
' ════════════════════════════════════════════════════════
legend right
  |= Simbolo       |= Significado          |
  | -->             | Conexion directa      |
  | ..>             | Llamada REST          |
  | Caja azul       | Modulo Frontend       |
  | Caja verde      | Endpoint Backend      |
  | Caja verde claro| Endpoint publico      |
  | Naranja         | Base de datos         |
  | Morado          | Servicio externo      |
  | Google OAuth    | Login con Google      |
  | Google Maps     | Mapa M4 y M8         |
endlegend

note as NOTA_PUB
  <b>/publico — endpoints sin JWT</b>
  GET /publico/precios
  GET /publico/estaciones
  GET /publico/zonas
  GET /publico/decretos/vigentes
  Rate limiting: 60 req/min por IP
  Usado por: Particular y consulta publica
end note

note as NOTA_GOOGLE
  <b>Google OAuth 2.0 (Passport.js)</b>
  GET  /auth/google         → inicia flujo OAuth
  GET  /auth/google/callback → recibe codigo
  Genera JWT identico al login email/password
  auth_provider: local | google | both
  ---
  <b>Google Maps JavaScript API</b>
  M4: mapa con marcadores de estaciones + precios
  M8: mini-mapa zona ciudadano + estaciones cercanas
  API Key publica — restringir dominio en GCP
end note

title Arquitectura -- Plataforma de Gestion de Combustibles\nDecreto 1428/2025  |  React + Express + Prisma + PostgreSQL\nDespliegue: Vercel + Railway + Supabase

@enduml
