// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ──────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────

enum TipoCombustible {
  ACPM
  GASOLINA_CORRIENTE
  GASOLINA_EXTRA
}

enum TipoServicio {
  PARTICULAR
  PUBLICO
  DIPLOMATICO
  OFICIAL
  CARGA
}

enum TipoTransaccion {
  ENTRADA
  SALIDA
}

enum TipoDistribuidor {
  MAYORISTA
  REGULADO
}

enum TipoZona {
  INTERCONECTADA
  NO_INTERCONECTADA
}

enum EstadoTransaccion {
  COMPLETADA
  ANULADA
  PENDIENTE
}

enum TipoReporte {
  INVENTARIO
  TRANSACCIONES
  PRECIOS
  AUDITORIA
  NORMATIVO
}

enum FormatoReporte {
  PDF
  EXCEL
  CSV
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

// ──────────────────────────────────────────
// MODULO: ACCESO Y USUARIOS
// ──────────────────────────────────────────

model Rol {
  id          String    @id @default(uuid())
  nombre      String    @unique // admin, estacion, distribuidor, regulador, auditor, particular, subsidiado, distribuidor_regulado
  descripcion String?
  permisos    Json?     @db.JsonB // Permisos JSONB como en el PlantUML
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  usuarios    Usuario[]

  @@map("roles")
}

model Usuario {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String?   @map("password_hash")
  googleId       String?   @unique @map("google_id")
  authProvider   AuthProvider @default(LOCAL) @map("auth_provider")
  fotoUrl        String?   @map("foto_url")
  nombre         String
  activo         Boolean   @default(true)
  rolId          String    @map("rol_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  rol          Rol               @relation(fields: [rolId], references: [id])
  auditorias   AuditoriaLog[]
  reportes     Reporte[]
  estacionGestionada EstacionServicio?
  distribuidorGestionado Distribuidor?

  @@index([rolId])
  @@map("usuarios")
}

// ──────────────────────────────────────────
// MODULO: ACTORES OPERATIVOS
// ──────────────────────────────────────────

model EstacionServicio {
  id           String   @id @default(uuid())
  usuarioId    String   @unique @map("usuario_id")
  nombre       String
  nit          String   @unique
  direccion    String
  ciudad       String
  departamento String
  codigoSicom  String   @unique @map("codigo_sicom") // Código SICOM del Ministerio
  latitud      Decimal? @db.Decimal(9, 6)
  longitud     Decimal? @db.Decimal(9, 6)
  zonaId       String   @map("zona_id")
  activa       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  zona          ZonaDistribucion         @relation(fields: [zonaId], references: [id])
  usuario       Usuario                  @relation(fields: [usuarioId], references: [id])
  tanques       Tanque[]
  transacciones TransaccionCombustible[]
  entregas      EntregaDistribuidor[]

  @@index([zonaId])
  @@index([ciudad, departamento])
  @@map("estaciones_servicio")
}

model Distribuidor {
  id           String           @id @default(uuid())
  usuarioId    String           @unique @map("usuario_id")
  nombre       String
  nit          String           @unique
  tipo         TipoDistribuidor
  direccion    String
  ciudad       String
  departamento String
  activo       Boolean          @default(true)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  usuario       Usuario                  @relation(fields: [usuarioId], references: [id])
  entregas      EntregaDistribuidor[]
  transacciones TransaccionCombustible[]

  @@map("distribuidores")
}

// ──────────────────────────────────────────
// MODULO: INVENTARIO
// ──────────────────────────────────────────

model Tanque {
  id               String          @id @default(uuid())
  nombre           String
  capacidadGalones Decimal         @map("capacidad_galones") @db.Decimal(10, 2)
  nivelActual      Decimal         @map("nivel_actual") @db.Decimal(10, 2)
  nivelMinimo      Decimal         @default(0) @map("nivel_minimo") @db.Decimal(10, 2)
  tipoCombustible  TipoCombustible @map("tipo_combustible")
  estacionId       String          @map("estacion_id")
  activo           Boolean         @default(true)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  estacion      EstacionServicio         @relation(fields: [estacionId], references: [id])
  transacciones TransaccionCombustible[]
  entregas      EntregaDistribuidor[]

  @@index([estacionId])
  @@index([tipoCombustible])
  @@map("tanques")
}

model TransaccionCombustible {
  id               String            @id @default(uuid())
  estacionId       String            @map("estacion_id")
  tanqueId         String            @map("tanque_id")
  distribuidorId   String?           @map("distribuidor_id")
  entregaId        String?           @map("entrega_id")
  tipo             TipoTransaccion   @default(SALIDA)
  tipoCombustible  TipoCombustible   @map("tipo_combustible")
  tipoServicio     TipoServicio      @map("tipo_servicio")
  galones          Decimal           @db.Decimal(10, 3)
  precioUnitario   Decimal           @map("precio_unitario") @db.Decimal(10, 2)
  precioTotal      Decimal           @map("precio_total") @db.Decimal(10, 2)
  placaVehiculo    String?           @map("placa_vehiculo")
  estado           EstadoTransaccion @default(COMPLETADA)
  decretoAplicado  String?           @map("decreto_aplicado")
  subsidioAplicado Boolean           @default(false) @map("subsidio_aplicado")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  estacion     EstacionServicio     @relation(fields: [estacionId], references: [id])
  tanque       Tanque               @relation(fields: [tanqueId], references: [id])
  distribuidor Distribuidor?        @relation(fields: [distribuidorId], references: [id])
  entrega      EntregaDistribuidor? @relation(fields: [entregaId], references: [id])

  @@index([estacionId, createdAt])
  @@index([tipoCombustible, tipoServicio])
  @@index([distribuidorId])
  @@index([entregaId])
  @@map("transacciones_combustible")
}

model EntregaDistribuidor {
  id              String          @id @default(uuid())
  distribuidorId  String          @map("distribuidor_id")
  estacionId      String          @map("estacion_id")
  tanqueId        String          @map("tanque_id")
  tipoCombustible TipoCombustible @map("tipo_combustible")
  galones         Decimal         @db.Decimal(10, 2)
  precioUnitario  Decimal         @map("precio_unitario") @db.Decimal(10, 2)
  precioTotal     Decimal         @map("precio_total") @db.Decimal(10, 2)
  numeroRemision  String          @unique @map("numero_remision")
  fechaEntrega    DateTime        @map("fecha_entrega")
  confirmada      Boolean         @default(false)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  distribuidor  Distribuidor             @relation(fields: [distribuidorId], references: [id])
  estacion      EstacionServicio         @relation(fields: [estacionId], references: [id])
  tanque        Tanque                   @relation(fields: [tanqueId], references: [id])
  transacciones TransaccionCombustible[]

  @@index([distribuidorId, fechaEntrega])
  @@index([estacionId])
  @@map("entregas_distribuidor")
}

// ──────────────────────────────────────────
// MODULO: PRECIOS Y NORMATIVA
// ──────────────────────────────────────────

model ZonaDistribucion {
  id            String    @id @default(uuid())
  nombre        String    @unique
  tipoZona      TipoZona  @default(INTERCONECTADA) @map("tipo_zona")
  departamentos String[] // Lista de departamentos en la zona
  descripcion   String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  estaciones EstacionServicio[]
  precios    PrecioVigente[]

  @@map("zonas_distribucion")
}

model PrecioVigente {
  id              String          @id @default(uuid())
  tipoCombustible TipoCombustible @map("tipo_combustible")
  tipoServicio    TipoServicio    @map("tipo_servicio")
  zonaId          String          @map("zona_id")
  precioGalon     Decimal         @map("precio_galon") @db.Decimal(10, 2)
  subsidioGalon   Decimal         @default(0) @map("subsidio_galon") @db.Decimal(10, 2)
  decretoId       String          @map("decreto_id")
  vigenciaDesde   DateTime        @map("vigencia_desde")
  vigenciaHasta   DateTime?       @map("vigencia_hasta")
  activo          Boolean         @default(true)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  zona    ZonaDistribucion @relation(fields: [zonaId], references: [id])
  decreto DecretoNormativo @relation(fields: [decretoId], references: [id])

  @@unique([tipoCombustible, tipoServicio, zonaId, activo])
  @@index([activo, tipoCombustible])
  @@index([zonaId])
  @@index([decretoId])
  @@map("precios_vigentes")
}

model DecretoNormativo {
  id              String   @id @default(uuid())
  numero          String   @unique // Ej: "1428/2025"
  titulo          String
  descripcion     String?
  entidad         String? // Entidad que expidió (Min. Hacienda, Min. Minas, etc.)
  fechaExpedicion DateTime @map("fecha_expedicion")
  fechaVigencia   DateTime @map("fecha_vigencia")
  activo          Boolean  @default(true)
  documentoUrl    String?  @map("documento_url")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  precios PrecioVigente[]

  @@map("decretos_normativos")
}

// ──────────────────────────────────────────
// MODULO: AUDITORIA Y REPORTES
// ──────────────────────────────────────────

model AuditoriaLog {
  id           String   @id @default(uuid())
  usuarioId    String   @map("usuario_id")
  modulo       String? // Módulo que generó el log (auth, inventario, precios, etc.)
  accion       String // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, etc.
  entidad      String // Nombre de la tabla afectada
  entidadId    String?  @map("entidad_id")
  datosAntes   Json?    @map("datos_antes") @db.JsonB
  datosDespues Json?    @map("datos_despues") @db.JsonB
  ip           String?
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId, createdAt])
  @@index([entidad, entidadId])
  @@map("auditoria_log")
}

model Reporte {
  id            String         @id @default(uuid())
  tipo          TipoReporte
  formato       FormatoReporte
  periodoInicio DateTime       @map("periodo_inicio") @db.Date
  periodoFin    DateTime       @map("periodo_fin") @db.Date
  parametros    Json?          @db.JsonB // Filtros aplicados al generar el reporte
  archivoUrl    String?        @map("archivo_url")
  generadoPor   String         @map("generado_por")
  createdAt     DateTime       @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [generadoPor], references: [id])

  @@index([tipo, createdAt])
  @@index([generadoPor])
  @@map("reportes")
}
